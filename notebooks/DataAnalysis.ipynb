   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as ticker\n",
    "\n",
    "# ── Load data ──────────────────────────────────────────────────────────────\n",
    "df = pd.read_csv(\"../data/metadata.csv\", sep=\"|\")\n",
    "print(df.head())"
   ],
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
