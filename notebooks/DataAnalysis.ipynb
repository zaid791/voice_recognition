   "source": [
    "# ── Chart 4: total recording minutes per class ────────────────────────────\n",
    "df[\"duration_min\"] = df[\"file\"].apply(\n",
    "    lambda f: get_duration_minutes(WAV_DIR + f.split(\"/\")[-1])\n",
    ")\n",
    "\n",
    "class_minutes = df.groupby(\"class\")[\"duration_min\"].sum().sort_index()\n",
    "labels = [f\"Class {i}\" for i in class_minutes.index]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 4))\n",
    "\n",
    "bars = ax.bar(labels, class_minutes.values, width=0.5,\n",
    "              edgecolor=\"white\", linewidth=1.2, zorder=3)\n",
    "\n",
    "# Value labels\n",
    "for bar in bars:\n",
    "    ax.text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        bar.get_height() + 0.02,\n",
    "        f\"{bar.get_height():.1f} min\",\n",
    "        ha=\"center\", va=\"bottom\", fontsize=12, fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "ax.set_title(\"Total recording minutes per class\")\n",
    "ax.set_ylabel(\"Minutes\")\n",
    "ax.grid(axis=\"y\", zorder=0)\n",
    "ax.set_ylim(0, class_minutes.max() * 1.2)\n",
    "ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
