   },
   "source": [
    "# ── Chart 2: audio count per speaker (class 1 only) ───────────────────────\n",
    "SPEAKERS = [\"Damian\", \"Inigo\", \"Mohammed\", \"Obama\", \"Ulyana\", \"Victor\"]\n",
    "\n",
    "class1_df = df[df[\"class\"] == 1]\n",
    "speaker_counts = (\n",
    "    class1_df[class1_df[\"speaker_id\"].isin(SPEAKERS)]\n",
    "    .groupby(\"speaker_id\", sort=False)\n",
    "    .size()\n",
    "    .reindex(SPEAKERS, fill_value=0)\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "bars = ax.bar(\n",
    "    speaker_counts.index, speaker_counts.values,\n",
    "    width=0.55, edgecolor=\"white\", linewidth=1.2, zorder=3\n",
    ")\n",
    "\n",
    "# Value labels\n",
    "for bar in bars:\n",
    "    ax.text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        bar.get_height() + 0.2,\n",
    "        str(int(bar.get_height())),\n",
    "        ha=\"center\", va=\"bottom\", fontsize=12, fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "ax.set_title(\"Audio samples per speaker  —  Class 1\")\n",
    "ax.set_ylabel(\"Number of files\")\n",
    "ax.yaxis.set_major_locator(ticker.MaxNLocator(integer=True))\n",
    "ax.grid(axis=\"y\", zorder=0)\n",
    "ax.set_ylim(0, speaker_counts.max() * 1.25)\n",
    "ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ],
