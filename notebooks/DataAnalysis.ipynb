  {
   "cell_type": "code",
   "id": "chart_minutes_speakers",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-26T15:09:35.122088Z",
     "start_time": "2026-11-26T15:09:34.933669Z"
    }
   },
   "source": [
    "# ── Chart 3: recording minutes per speaker (class 1 only) ─────────────────\n",
    "import wave\n",
    "\n",
    "WAV_DIR = \"../data/wav/\"\n",
    "\n",
    "def get_duration_minutes(file_path):\n",
    "    \"\"\"Returns duration in minutes of a WAV file using the standard library.\"\"\"\n",
    "    with wave.open(file_path, 'r') as wf:\n",
    "        frames = wf.getnframes()\n",
    "        rate   = wf.getframerate()\n",
    "        return (frames / rate) / 60.0\n",
    "\n",
    "class1_df = df[df[\"class\"] == 1].copy()\n",
    "class1_df[\"duration_min\"] = class1_df[\"file\"].apply(\n",
    "    lambda f: get_duration_minutes(WAV_DIR + f.split(\"/\")[-1])\n",
    ")\n",
    "\n",
    "speaker_minutes = (\n",
    "    class1_df[class1_df[\"speaker_id\"].isin(SPEAKERS)]\n",
    "    .groupby(\"speaker_id\", sort=False)[\"duration_min\"]\n",
    "    .sum()\n",
    "    .reindex(SPEAKERS, fill_value=0)\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "bars = ax.bar(\n",
    "    speaker_minutes.index, speaker_minutes.values,\n",
    "    width=0.55, edgecolor=\"white\", linewidth=1.2, zorder=3\n",
    ")\n",
    "\n",
    "# Value labels (rounded to 1 decimal)\n",
    "for bar in bars:\n",
    "    ax.text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        bar.get_height() + 0.02,\n",
    "        f\"{bar.get_height():.1f} min\",\n",
    "        ha=\"center\", va=\"bottom\", fontsize=10, fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "ax.set_title(\"Recording minutes per speaker  —  Class 1\")\n",
    "ax.set_ylabel(\"Minutes\")\n",
    "ax.grid(axis=\"y\", zorder=0)\n",
    "ax.set_ylim(0, speaker_minutes.max() * 1.25)\n",
    "ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ],
